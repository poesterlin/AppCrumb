	},
	"homepage": "https://github.com/poesterlin/celld-sites/tree/main/packages/runtime",
	"files": [
		"index.ts",
		"visitor.ts",
		"objects.ts",
		"assets.ts",
		"README.md"
	],
	"exports": {
		".": "./index.ts",
		"./visitor.ts": "./visitor.ts",
		"./objects.ts": "./objects.ts",
		"./assets.ts": "./assets.ts"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=20"
	}
