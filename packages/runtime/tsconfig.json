{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023", "DOM"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"types": ["node"],
		"strict": false,
		"noImplicitAny": false,
		"strictNullChecks": false
	},
	"include": ["./**/*.ts", "../../types/celld.d.ts"],
	"exclude": ["./**/*.test.ts"]
}
