# Credentials for the internal S3 bucket (VersityGW root user). Any random strings.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Token for the router's deploy API (A-Z a-z 0-9 _ - only).
ADMIN_TOKEN=
# Hostname of the test site (tools/deploy.sh sites/example $HOST_DOMAIN) and the
# default SITES_RULE when that is unset (LAN only).
HOST_DOMAIN=celld-test.example.com
# Traefik rule for all site hostnames (defaults to HOST_DOMAIN only). Use a
# pattern so new sites and aliases need no restart; single quotes keep the `$`.
# Exclude the dashboard host (DASHBOARD_HOST) if the pattern matches it.
# Hostnames outside the pattern can be added: ... || Host(`blog.other.com`)
SITES_RULE='HostRegexp(`^celld-[a-z0-9-]+\.example\.com$`) && !Host(`celld-admin.example.com`)'
# Flush each bucket object to disk before acknowledging it (safe default).
# false = faster writes, but a VM crash can lose the last seconds of writes.
# S3_FSYNC=true
# Read-only token for the admin API (dashboard). Same charset as ADMIN_TOKEN.
READ_TOKEN=
# Password for the dashboard (HTTP Basic, user admin or DASHBOARD_USER); at least
# 12 characters: openssl rand -hex 24
DASHBOARD_PASSWORD=
# Hostname of the read-only dashboard (no auth: keep it LAN-only).
DASHBOARD_HOST=celld-admin.example.com
# Memory limit of the celld node (each loaded EmDash site ~120 MB).
# CELLD_MEM_LIMIT=8g
# Per-isolate V8 heap limit in MB (celld's default is 128; an EmDash site is
# ~120 MB once loaded, so it gets headroom for query result sets).
# CELLD_V8_HEAP_LIMIT_MB=256
# Per-site limits (defaults shown); a site over them gets 503s or errors, the
# rest of the node is unaffected.
# SITE_TIMEOUT_SECS=30
# SITE_MAX_INFLIGHT=128
# SITE_MAX_OBJECTS=1000
# SITE_MAX_SUBREQUESTS=1000
# AppCrumb: the app catalog (LAN-only by default), only for a host that
# runs the store (COMPOSE_PROFILES includes "store"). Its hostname must not
# match SITES_RULE. See store/README.md.
STORE_HOST=store.example.com
# The store's Postgres (shared with the moderation site). Hex, so it fits in a
# URL: openssl rand -hex 24
STORE_DB_PASSWORD=
# Traefik injects this as X-Hamstr-Proxy so the store only trusts X-Real-Ip from
# the proxy, not from other containers on the same Docker network.
# openssl rand -hex 24
STORE_PROXY_SECRET=
# 1: new releases wait for a moderator (required once the store is public).
STORE_REQUIRE_REVIEW=0
# Footer links for a public store: a legal notice and a privacy policy where
# your jurisdiction requires them (Germany: Impressum and Datenschutz).
# STORE_IMPRINT_URL=https://example.com/impressum
# STORE_PRIVACY_URL=https://example.com/datenschutz
# The moderation site: review queue, reports, takedowns, suspensions. LAN-only;
# never put it in the Cloudflare tunnel. Prefer OIDC (Tailscale tsidp); the
# shared password is a fallback for local tests only.
MODERATION_HOST=moderation.example.com
# MODERATION_PASSWORD=   # openssl rand -base64 18 — unused when OIDC is set
# MODERATION_OIDC_NAME=Tailscale
# MODERATION_OIDC_ISSUER=https://idp.example.ts.net
# MODERATION_OIDC_CLIENT_ID=
# MODERATION_OIDC_CLIENT_SECRET=
# Redirect URI registered at the IdP: https://$MODERATION_HOST/auth/callback
# MODERATION_OIDC_ALLOW=you@example.com
# Policy; these are the defaults (see store/README.md, "Moderation").
# MODERATION_REVIEW_AT=0.4
# MODERATION_BLOCK_AT=0.9
# MODERATION_AUTO_BLOCK=1
# MODERATION_AUTO_APPROVE=0
# MODERATION_AUTO_APPROVE_TRUSTED=1
# Optional classifier (TypeSafe Jev): setting either turns it on. It sends each
# release's listing, page text and the start of its server code to JEV_URL, so
# use an endpoint whose data terms you accept for publishers' code.
# JEV_API_KEY=
# JEV_URL=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-latest
# Interactive demo node (store "Try it live"). Separate bucket, state and token.
DEMO_ADMIN_TOKEN=
DEMO_READ_TOKEN=
STORE_DEMO_DOMAIN=example.com
STORE_DEMO_TTL_SECS=900
STORE_DEMO_MAX=100
STORE_DEMO_PER_HOUR=10
# Hamstr: the personal app shell (crumbs, OIDC sign-in). LAN-only.
# Enable it with the compose profile ("hamstr,store" to also run the store);
# see hamstr/README.md.
# COMPOSE_PROFILES=hamstr
# The store Hamstr gets apps from. Defaults to the store in this stack; a
# personal node without the "store" profile points at a hosted one.
# HAMSTR_STORE=https://appcrumb.store
# HAMSTR_STORE_PUBLIC=https://appcrumb.store
# Local catalog while developing the store profile: HAMSTR_STORE=http://store:3000
HAMSTR_HOST=hamstr.example.com
# Crumbs live at crumb-<id>.<HAMSTR_CRUMB_DOMAIN>; the rule must match exactly those.
HAMSTR_CRUMB_DOMAIN=example.com
HAMSTR_CRUMBS_RULE='HostRegexp(`^crumb-[a-z0-9]{12}[.]example[.]com$`)'
# Generate both with: openssl rand -base64 32 | tr -d '/+='
HAMSTR_PROXY_TOKEN=
HAMSTR_SECRET=
# The first sign-in provider, seeded on a fresh install (later: Settings → Sign-in).
# Register the OIDC client at your provider (any OIDC IdP; tsidp is the
# Tailscale one) with the redirect URI
# https://<HAMSTR_HOST>/auth/callback/<id>, where <id> is the name in lowercase
# ("tailscale" if you use tsidp with its default name).
# HAMSTR_OIDC_NAME=Tailscale
HAMSTR_OIDC_ISSUER=https://idp.example.com
HAMSTR_OIDC_CLIENT_ID=
HAMSTR_OIDC_CLIENT_SECRET=
# The first person to sign in becomes the owner; everyone else waits for approval
# (or comes with an invite) on Settings → People.
# Upgrading from before accounts: people who already signed in are brought over,
# the earliest as owner and these (comma-separated emails or usernames, "*" =
# everyone) as admins. Not read after that.
HAMSTR_ADMINS=

# Sign-in for celld sites (`"auth": "required"` in celld.json), done by Hamstr.
# AUTH_URL is https://<HAMSTR_HOST>/auth; AUTH_KEY is the HMAC key shared by the
# router and Hamstr (openssl rand -hex 32). Restart celld after changing either.
AUTH_URL=
AUTH_KEY=

# tsidp (profile "tsidp"): the tailnet hostname and the file holding its auth key.
# TSIDP_HOSTNAME=idp
# TSIDP_FUNNEL=1 publishes the IdP on the internet (Tailscale Funnel); off by default.
# TSIDP_AUTHKEY_FILE=./secrets/ts_authkey
