# Shared by both Caddyfiles: the shell and every crumb go to Hamstr, anything
# else to the celld router.

# The router's admin API answers on this name only. It is reached on loopback,
# never through the front door.
@admin host {$ADMIN_HOST}
respond @admin 404

@hamstr host {$HAMSTR_HOST}
@crumbs {
	host *.{$HAMSTR_CRUMB_DOMAIN}
	header_regexp Host ^crumb-
}
reverse_proxy @hamstr 127.0.0.1:{$HAMSTR_PORT}
reverse_proxy @crumbs 127.0.0.1:{$HAMSTR_PORT}
reverse_proxy 127.0.0.1:{$CELLD_PORT}
